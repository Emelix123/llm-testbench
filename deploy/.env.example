# Vorlage für deploy/.env  –  wird von ./scenario.sh init kopiert und mit Zufallswerten gefüllt.
# deploy/.env enthält Geheimnisse und ist per .gitignore ausgeschlossen.

# --------------------------------------------------------------------------- Images
# Fest gepinnt (Reproduzierbarkeit der Messungen). "latest" zieht bei jedem Pull etwas anderes.
# vLLM >= 0.24.0 schließt CVE-2026-55514/-54234, >= 0.14.1 CVE-2026-22778; Wasserzeichen ab ~0.30.
VLLM_IMAGE=vllm/vllm-openai:v0.34.0
LITELLM_IMAGE=ghcr.io/berriai/litellm-database:v1.106.7
POSTGRES_IMAGE=postgres:16-alpine

# --------------------------------------------------------------------------- GPU
# Auf welcher GPU vLLM rechnet (alle Szenarien; in K5 beide Instanzen auf dieser GPU): Index aus
# `nvidia-smi -L` oder UUID (GPU-…, bleibt auch nach Umbauten gleich). init wählt bei mehreren GPUs die
# mit dem meisten Speicher, bei Gleichstand die ohne Monitor. Ändern: ./scenario.sh gpu <Index>
LLMTB_GPU=0

# --------------------------------------------------------------------------- Modell
# Modellprofil – ./scenario.sh init wählt es nach dem VRAM, ./scenario.sh modell standard|klein wechselt:
#   standard  Qwen/Qwen3-8B    ab ~44 GB VRAM (alle Szenarien einschließlich K5), z. B. RTX PRO 6000
#   klein     Qwen/Qwen3-0.6B  Laptop (4-GB-GPU, RTX 3050)
# Die folgenden fünf Werte gehören zum Profil; von Hand nur gemeinsam ändern.
MODELL_PROFIL=standard
MODEL=Qwen/Qwen3-8B
# Name, unter dem Gateway UND Engine das Modell anbieten (Endpunkt-Profil: Modell = llm)
SERVED_MODEL_NAME=llm
MAX_MODEL_LEN=2048
# KV-Cache fest in Bytes (hat Vorrang vor GPU_MEMORY_UTILIZATION). Gleiche Kapazität in allen
# Szenarien = vergleichbare Messungen. Je Profil so gewählt, dass es ~6 540 Tokens sind (darauf sind
# die Tests ausgelegt): Qwen3-8B 965000000 (147 456 B je Token), Qwen3-0.6B 750000000 (114 688 B).
# Leer = vLLM nimmt, was GPU_MEMORY_UTILIZATION übrig lässt (dann nicht mehr vergleichbar).
KV_CACHE_MEMORY=965000000
# K5 (zwei Instanzen auf EINER GPU) – KV-Cache je Instanz, ~4 360 Tokens (Qwen3-0.6B: 500000000)
KV_CACHE_MEMORY_DEDICATED=643000000
# Speicherbedarf je Instanz in MB: angefordert / mindestens (K5 braucht 2 × Mindestbedarf + 400 MB)
MODEL_GPU_MB=24000
MODEL_GPU_MIN_MB=22000
# Obergrenze, die vLLM beim Start gegen den FREIEN GPU-Speicher prüft. Berechnet init/gpu aus
# MODEL_GPU_MB und dem VRAM (Werte hier: RTX PRO 6000, 96 GB).
GPU_MEMORY_UTILIZATION=0.25
GPU_MEMORY_UTILIZATION_DEDICATED=0.22
# Hugging-Face-Cache des WSL-Nutzers (im Linux-Dateisystem, NICHT unter /mnt/c)
HF_CACHE=~/.cache/huggingface
# Nutzer, unter dem die gehärteten Container (K4) laufen – Eigentümer von deploy/secrets/
LLMTB_UID=1000
LLMTB_GID=1000
# Nur für gesperrte Modelle:
HF_TOKEN=

# --------------------------------------------------------------------------- Geheimnisse
# Werden von ./scenario.sh init erzeugt. Nicht von Hand einfache Werte setzen.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
POSTGRES_PASSWORD=
# Schlüssel zwischen Gateway und Engine (vLLM --api-key / VLLM_API_KEY)
VLLM_API_KEY=

# --------------------------------------------------------------------------- Mandanten
# Drei Mandanten für die Tests: A = Opfer, B = Angreifer, C = Last anderer Mandanten.
TENANT_A_KEY=
TENANT_B_KEY=
TENANT_C_KEY=
# Weitere Mandanten (Teams pool-01 … pool-NN) für den Test „Kosten der Cache-Trennung“: Er misst,
# was cache_salt bei vielen Mandanten kostet. Die Keys werden aus TENANT_POOL_SECRET abgeleitet
# (init erzeugt es). 0 = keine weiteren Mandanten.
TENANT_POOL_SIZE=30
TENANT_POOL_SECRET=
